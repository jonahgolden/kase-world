{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kase-world",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kase-world", "database_id": "4022fa55-779b-4ab8-8552-add2781a2d11" }
  ],
  "ratelimits": [
    { "name": "SUBMIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
